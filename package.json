{
  "name": "@gyga-browser/webmcp-vault-kit",
  "version": "0.1.0",
  "description": "Local encrypted credential vault (store API, CLI, and web UI) for the WebMCP automation kit: usernames, passwords, TOTP, notes, and website logins.",
  "license": "MIT",
  "author": "uyencss",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uyencss/webmcp-vault-kit.git"
  },
  "bin": {
    "webmcp-vault": "bin/webmcp-vault.mjs"
  },
  "main": "lib/store.js",
  "exports": {
    ".": "./lib/store.js",
    "./approval-receipt": "./lib/approval-receipt.js",
    "./broker": "./lib/broker.js",
    "./ui-server": "./lib/ui-server.js",
    "./bin": "./bin/webmcp-vault.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "bin/",
    "docs/",
    "lib/",
    "skills/webmcp-vault/",
    "webmcp-vault-extension/dist/",
    ".env.example",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "ui": "node bin/webmcp-vault.mjs ui",
    "build:extension": "node scripts/build-extension-zip.mjs",
    "test:ui": "node tests/unit/vault-ui-server.test.mjs",
    "test": "node --test tests/unit/*.test.mjs",
    "test:coverage": "node --experimental-test-coverage --test tests/unit/*.test.mjs"
  },
  "engines": {
    "node": ">=18"
  }
}
